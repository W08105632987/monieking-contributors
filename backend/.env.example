# ================================================================
# MonieKing backend — environment template.
# Copy this to .env and fill in real values. Never commit the real .env.
# ================================================================

APP_ENV=development
APP_NAME=MonieKing Contributors
APP_VERSION=0.1.0
DEBUG=false

# ── Database (Supabase Postgres) ────────────────────────────────
# IMPORTANT: use the SESSION/direct connection (port 5432), not the
# transaction-mode pooler (port 6543) — this app manages its own
# connection pool, so stacking it on top of Supabase's transaction
# pooler causes DuplicatePreparedStatementError under load.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── CORS + cookies + WebAuthn ────────────────────────────────────
# Comma-separated. Add every origin you actually use — localhost for
# dev, your Cloudflare Tunnel domain, and your real production domain
# once you have one. WEBAUTHN_ORIGIN accepts multiple the same way.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MonieKing Contributors

# Cookie settings — leave as-is for local dev. COOKIE_SECURE
# auto-forces true whenever APP_ENV=production, regardless of this flag.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Redis (rate limiting, idempotency, Celery broker) ───────────
REDIS_URL=redis://localhost:6379/0

# ── Monnify ───────────────────────────────────────────────────────
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
MONNIFY_SOURCE_ACCOUNT_NUMBER=

# Youverify — identity verification (NIN/BVN/TIN/KYB). Get the token from
# os.youverify.co -> Account Settings -> API/Webhooks. Use a Test-mode
# token here until the pricing/sandbox review is done — see the
# identity_services catalog seed for which services are wired up.
YOUVERIFY_BASE_URL=https://api.youverify.co
YOUVERIFY_TOKEN=

# ── SMS Gateway (Termii, optional) ────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=MonieKing

# ── Error monitoring (optional, deferred) ─────────────────────────
SENTRY_DSN=

# ── Email (SMTP) — used only for system-health alerts. Any SMTP relay
# works: Gmail app password, SendGrid SMTP, Mailgun SMTP, AWS SES SMTP. ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@monieking.app
SMTP_USE_TLS=true

# ── System health monitor — who gets alerted, and how sensitive the
# database-latency check is. Comma-separate multiple recipients. ──────
ALERT_EMAIL_TO=
ALERT_PHONE_TO=
HEALTH_CHECK_ALERT_COOLDOWN_MINUTES=20
HEALTH_CHECK_DB_LATENCY_WARN_MS=500
HEALTH_CHECK_DB_LATENCY_CRITICAL_MS=2000

# ── Web Push (browser/phone notifications). BOTH keys are required; leave
# blank to disable push entirely (the app then shows "not configured").
# 1) Run migration 043 FIRST (backend/run_migration_043.py).
# 2) Generate a pair:  python backend/scripts/generate_vapid_keys.py
# 3) Paste the PEM as VAPID_PRIVATE_KEY_PEM (multi-line, or one line with
#    literal \n) and the printed public key as VAPID_PUBLIC_KEY_B64.
# The private key is a SECRET: server-side env only, never in the frontend
# or in git. Changing the pair later invalidates every existing subscription
# (users must toggle push off/on again). ─────────────────────────────────
VAPID_PRIVATE_KEY_PEM=
VAPID_PUBLIC_KEY_B64=
VAPID_SUBJECT=mailto:support@monieking.com
