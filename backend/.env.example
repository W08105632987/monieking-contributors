# ================================================================
# MonieKing backend — environment template.
# Copy this to .env and fill in real values. Never commit the real .env.
# ================================================================

APP_ENV=development
APP_NAME=MonieKing Contributors
APP_VERSION=0.1.0
DEBUG=false

# ── Database (Supabase Postgres) ────────────────────────────────
# IMPORTANT: use the SESSION/direct connection (port 5432), not the
# transaction-mode pooler (port 6543) — this app manages its own
# connection pool, so stacking it on top of Supabase's transaction
# pooler causes DuplicatePreparedStatementError under load.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── CORS + cookies + WebAuthn ────────────────────────────────────
# Comma-separated. Add every origin you actually use — localhost for
# dev, your Cloudflare Tunnel domain, and your real production domain
# once you have one. WEBAUTHN_ORIGIN accepts multiple the same way.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MonieKing Contributors

# Cookie settings — leave as-is for local dev. COOKIE_SECURE
# auto-forces true whenever APP_ENV=production, regardless of this flag.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Redis (rate limiting, idempotency, Celery broker) ───────────
REDIS_URL=redis://localhost:6379/0

# ── Monnify ───────────────────────────────────────────────────────
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
MONNIFY_SOURCE_ACCOUNT_NUMBER=

# ── SMS Gateway (Termii, optional) ────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=MonieKing

# ── Error monitoring (optional, deferred) ─────────────────────────
SENTRY_DSN=
