# ── Backend API ───────────────────────────────────────────────────
# Leave this UNSET for local dev — api.ts falls back to a relative
# "/api/v1" path, which rides Vite's dev proxy (vite.config.ts) to
# localhost:8000. Only set this for a real deployed backend, e.g.:
# VITE_API_URL=https://admin.monieking.webodemos.com/api/v1

# ── App ───────────────────────────────────────────────────────────
VITE_APP_NAME=MonieKing Admin
VITE_APP_ENV=development
