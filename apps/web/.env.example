# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Backend API ───────────────────────────────────────────────────
# Leave this UNSET for local/LAN dev. api.ts falls back to a relative
# "/api/v1" path, which rides Vite's dev proxy (vite.config.ts) to
# localhost:8000 on whichever machine is running the dev server — this
# keeps working even when your router hands out a new LAN IP, which a
# hardcoded "http://192.168.x.x:8000" does not survive.
# Only set this for a real deployed backend, e.g.:
# VITE_API_URL=https://app.yourdomain.com/api/v1

# ── App ───────────────────────────────────────────────────────────
VITE_APP_NAME=MonieKing Contributors
VITE_APP_ENV=development
VITE_WEBAUTHN_RP_ID=localhost
VITE_WEBAUTHN_RP_NAME=MonieKing Contributors
